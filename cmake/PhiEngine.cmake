include_guard(GLOBAL)

# ---------------------------------------------------------------------------
# phi_configure_target(<target>)
#   Common compile settings shared by every engine target.
# ---------------------------------------------------------------------------
function(phi_configure_target target)
    target_compile_features(${target} PUBLIC cxx_std_23)
    if(MSVC)
        target_compile_options(${target} PRIVATE /W4 /permissive-)
        if(PHI_WARNINGS_AS_ERRORS)
            target_compile_options(${target} PRIVATE /WX)
        endif()
    else()
        target_compile_options(${target} PRIVATE -Wall -Wextra -Wpedantic -Wshadow -Wnon-virtual-dtor)
        if(PHI_WARNINGS_AS_ERRORS)
            target_compile_options(${target} PRIVATE -Werror)
        endif()
    endif()
endfunction()

# ---------------------------------------------------------------------------
# phi_add_library(<name> SOURCES ... [PUBLIC_DEPS ...] [PRIVATE_DEPS ...])
#   Declares an engine library `phi_<name>` (alias `phi::<name>`).
#   Public headers live in `include/` next to the calling CMakeLists.txt.
# ---------------------------------------------------------------------------
function(phi_add_library name)
    cmake_parse_arguments(ARG "" "" "SOURCES;PUBLIC_DEPS;PRIVATE_DEPS" ${ARGN})

    if(PHI_SHARED_MODULES)
        set(kind SHARED)
    else()
        set(kind STATIC)
    endif()

    set(target phi_${name})
    add_library(${target} ${kind} ${ARG_SOURCES})
    add_library(phi::${name} ALIAS ${target})
    target_include_directories(${target} PUBLIC
        $<BUILD_INTERFACE:${CMAKE_CURRENT_SOURCE_DIR}/include>)
    target_link_libraries(${target} PUBLIC ${ARG_PUBLIC_DEPS} PRIVATE ${ARG_PRIVATE_DEPS})
    phi_configure_target(${target})
endfunction()

# ---------------------------------------------------------------------------
# phi_add_module(<name> SOURCES ... [DEPS ...])
#   Declares an engine module `phi_module_<name>`.
#
#   - PHI_SHARED_MODULES=ON : a plugin, loaded at runtime by name.
#   - PHI_SHARED_MODULES=OFF: a static library, registered through
#     phi_target_modules().
#
#   The module name is injected as PHI_MODULE_NAME so that the entry point
#   emitted by PHI_DEFINE_MODULE() always matches the CMake name.
# ---------------------------------------------------------------------------
function(phi_add_module name)
    cmake_parse_arguments(ARG "" "" "SOURCES;DEPS" ${ARGN})

    if(PHI_SHARED_MODULES)
        set(kind SHARED)
    else()
        set(kind STATIC)
    endif()

    set(target phi_module_${name})
    add_library(${target} ${kind} ${ARG_SOURCES})
    add_library(phi::module::${name} ALIAS ${target})
    target_include_directories(${target} PRIVATE ${CMAKE_CURRENT_SOURCE_DIR}/src)
    target_compile_definitions(${target} PRIVATE PHI_MODULE_NAME=${name})
    target_link_libraries(${target} PRIVATE ${ARG_DEPS})
    phi_configure_target(${target})

    set_property(GLOBAL APPEND PROPERTY PHI_MODULES ${name})
endfunction()

# ---------------------------------------------------------------------------
# phi_target_modules(<target> <module>...)
#   Makes modules available to an executable.
#
#   Shared mode: only adds a build dependency; the executable has no link-time
#   knowledge of the modules and loads them by name at runtime.
#   Static mode: links the modules and generates a translation unit that
#   registers their factories into the StaticModuleRegistry.
#
#   Modules that are disabled (PHI_MODULE_* = OFF) are skipped silently.
# ---------------------------------------------------------------------------
function(phi_target_modules target)
    set(declarations "")
    set(registrations "")

    foreach(module IN LISTS ARGN)
        if(NOT TARGET phi_module_${module})
            message(STATUS "phi: module '${module}' is disabled, not attached to ${target}")
            continue()
        endif()

        if(PHI_SHARED_MODULES)
            add_dependencies(${target} phi_module_${module})
        else()
            target_link_libraries(${target} PRIVATE phi_module_${module})
            string(APPEND declarations
                "extern \"C\" ::phi::IModule* phi_create_module_${module}();\n")
            string(APPEND registrations
                "        ::phi::StaticModuleRegistry::add(\"${module}\", &phi_create_module_${module});\n")
        endif()
    endforeach()

    set(generated ${CMAKE_CURRENT_BINARY_DIR}/${target}_static_modules.cpp)
    file(CONFIGURE OUTPUT ${generated} CONTENT
"// Generated by phi_target_modules(). Do not edit.
#include <phi/core/ModuleManager.hpp>

${declarations}
namespace {
struct StaticModuleRegistration {
    StaticModuleRegistration() {
${registrations}    }
};
const StaticModuleRegistration registration;
}  // namespace
" @ONLY)
    target_sources(${target} PRIVATE ${generated})
    target_link_libraries(${target} PRIVATE phi::core)
endfunction()

# ---------------------------------------------------------------------------
# phi_compile_shaders(<target> OUTPUT_DIR <dir> SOURCES <glsl>...
#                      [INCLUDE_DIRS <dir>...])
#   Compiles GLSL sources to SPIR-V (`<name>.spv`) with glslc. Files pulled in
#   with #include are tracked through a depfile, so editing a shared header
#   rebuilds the shaders that use it. The engine's shader include directory
#   (PHI_SHADER_INCLUDE_DIR) is always on the include path.
# ---------------------------------------------------------------------------
function(phi_compile_shaders target)
    cmake_parse_arguments(ARG "" "OUTPUT_DIR" "SOURCES;INCLUDE_DIRS" ${ARGN})

    find_program(PHI_GLSLC glslc HINTS $ENV{VULKAN_SDK}/bin $ENV{VULKAN_SDK}/Bin REQUIRED)

    set(include_flags "")
    foreach(dir IN LISTS PHI_SHADER_INCLUDE_DIR ARG_INCLUDE_DIRS)
        list(APPEND include_flags -I ${dir})
    endforeach()

    set(outputs "")
    foreach(source IN LISTS ARG_SOURCES)
        get_filename_component(source_abs ${source} ABSOLUTE)
        get_filename_component(source_name ${source} NAME)
        set(output ${ARG_OUTPUT_DIR}/${source_name}.spv)
        add_custom_command(
            OUTPUT ${output}
            COMMAND ${CMAKE_COMMAND} -E make_directory ${ARG_OUTPUT_DIR}
            COMMAND ${PHI_GLSLC} -O --target-env=vulkan1.3 ${include_flags}
                    -MD -MF ${output}.d ${source_abs} -o ${output}
            DEPENDS ${source_abs}
            DEPFILE ${output}.d
            COMMENT "Compiling shader ${source_name}"
            VERBATIM)
        list(APPEND outputs ${output})
    endforeach()

    add_custom_target(${target} ALL DEPENDS ${outputs})
endfunction()
